# Agentic baseline: mini-SWE-agent (scripts/agentic/run_agent.py) with the same
# model, settings and 47 issues as the Agentless runs. Usage:
#   CONFIG=scripts/configs/agent_flashlite.env scripts/pipeline.sh agentic
AGENT_PROVIDER=gemini
MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_EFFORT=none   # same as the Agentless runs
GEMINI_RPM=15
GEMINI_TPM=200000
AGENTLESS_INSTANCE_IDS_FILE=data/subset_47.txt
RESULTS=results/agent_flashlite
RUN_NAME=agent_flashlite       # Docker run id of the evaluation
WORKERS=1                      # 12 GB RAM: one agent container at a time
AGENT_STEP_LIMIT=50            # 1 step = 1 LLM request; mini-swe-agent default is 250
AGENT_COST_LIMIT=1.0           # US$ per issue (never reached at Flash-Lite prices)
AGENT_TEMPERATURE=0
