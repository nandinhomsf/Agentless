# Extension of flashlite_reduced.env (same settings) to the 32 issues of
# subset_40 not in subset_15; together they cover 47 Lite-S issues.
BACKEND=gemini
MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_EFFORT=none   # no thinking, like GPT-4o in the paper
GEMINI_RPM=15
GEMINI_TPM=200000
AGENTLESS_INSTANCE_IDS_FILE=data/subset_ext.txt   # subset_40 minus subset_15
RESULTS=results/flashlite_reduced_ext
THREADS=4
WORKERS=1      # Docker: with 12 GB RAM, parallel env builds triggered the OOM killer
N_LOC=2        # edit-location samples (4)
N_REPAIR=3     # patches per location set (10) -> 6 patches/issue (40)
N_REPRO=4      # reproduction test samples (40)
# context limit: paper default (128k), so no issue has to be skipped
