# Reduced replication: Gemma 4 31B (Gemini API free tier), 15 Lite-S issues.
# Paper defaults in parentheses.
BACKEND=gemini
MODEL=gemma-4-31b-it
GEMINI_RPM=25
GEMINI_TPM=14000   # free tier caps Gemma at 16k input tokens/min
GEMINI_THINKING_HEADROOM=15360   # Gemma reasons inline; repair needs >5k tokens
AGENTLESS_INSTANCE_IDS_FILE=data/subset_15.txt
RESULTS=results/gemma_reduced
THREADS=3      # latency-bound (~1-5 min/request); the TPM limiter is shared
WORKERS=1      # Docker: with 12 GB RAM, parallel env builds triggered the OOM killer
N_LOC=2        # edit-location samples (4)
N_REPAIR=3     # patches per location set (10) -> 6 patches/issue (40)
N_REPRO=4      # reproduction test samples (40)
# Agentless drops the least suspicious files until a prompt fits the context
# (128k for GPT-4o). Gemma's free tier caps input at 16k tokens/min, so a single
# larger prompt can never be served; measured tiktoken->Gemma ratio is up to 1.8x.
AGENTLESS_MAX_CONTEXT_LENGTH=8500
