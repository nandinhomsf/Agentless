# Agentic approach (mini-SWE-agent) with OpenAI gpt-6-luna (paid, prepaid credits),
# on the 47 issues. Needs OPENAI_API_KEY in .env. Usage:
#   CONFIG=pesquisa/scripts/configs/agent_luna.env pesquisa/scripts/pipeline.sh agentic
AGENT_PROVIDER=openai
MODEL=gpt-6-luna                 # US$ 0.10 / 0.50 per 1M tokens (PRECOS in pesquisa/scripts/extra_metrics.py)
OPENAI_REASONING_EFFORT=medium   # same as the Agentless Luna config (luna_reduced.env)
OPENAI_RPM=50
OPENAI_TPM=0                     # no token throttle
AGENTLESS_INSTANCE_IDS_FILE=pesquisa/data/subset_47.txt
RESULTS=pesquisa/results/agent_luna
RUN_NAME=agent_luna              # Docker run id of the evaluation
WORKERS=1                        # 12 GB RAM: one agent container at a time
AGENT_STEP_LIMIT=50
AGENT_COST_LIMIT=0.50            # US$ per issue
AGENT_BUDGET=5                   # US$ for the whole run; stops (exit 4) once reached
