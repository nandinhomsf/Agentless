# Agentless with gpt-6-luna via openai-reasoning backend (prepaid credits), the other 32 issues (together: 47).
# Same reduced configuration as the Haiku runs (2x3 patches, 4 reproduction tests).
# Model id: confirm it in the provider console before running.
BACKEND=openai-reasoning
MODEL=gpt-6-luna
# Luna is a reasoning model. Effort: low|medium|high (AA index 28 at max; 9 non-reasoning,
# whether 'none' is accepted by the API: check). Reasoning tokens count against
# max_completion_tokens, hence the headroom.
OPENAI_REASONING_EFFORT=medium
OPENAI_THINKING_HEADROOM=8192
OPENAI_RPM=50
OPENAI_TPM=0
AGENTLESS_INSTANCE_IDS_FILE=pesquisa/data/subset_ext.txt   # subset_40 minus subset_15
RESULTS=pesquisa/results/luna_reduced_ext
THREADS=4
WORKERS=1      # Docker: 12 GB RAM (parallel env builds triggered the OOM killer)
N_LOC=2        # edit-location samples (4)
N_REPAIR=3     # patches per location set (10) -> 6 patches/issue (40)
N_REPRO=4      # reproduction test samples (40)
# Docker run ids: the prefix keeps the harness from reusing reports of other runs
RUN_PREFIX=luna_
