# Agentless with claude-haiku-5-5 via anthropic-native backend (prepaid credits), the other 32 issues (together: 47).
# Same reduced configuration as the Luna runs (2x3 patches, 4 reproduction tests).
# Model id: confirm it in the provider console before running.
BACKEND=anthropic-native
MODEL=claude-haiku-5-5
# Native Messages API: output_config.effort (low|medium|high; empty = provider default).
# Thinking tokens count against max_tokens, hence the headroom.
ANTHROPIC_EFFORT=medium
ANTHROPIC_THINKING_HEADROOM=8192
ANTHROPIC_RPM=50
ANTHROPIC_TPM=0
AGENTLESS_INSTANCE_IDS_FILE=pesquisa/data/subset_ext.txt   # subset_40 minus subset_15
RESULTS=pesquisa/results/haiku_reduced_ext
THREADS=4
WORKERS=6      # Docker: 24 GB RAM, 6 nucleos fisicos; 6 containers de teste em paralelo (lote 1 usou 4). Voltar a 4 se houver pressao de memoria
N_LOC=2        # edit-location samples (4)
N_REPAIR=3     # patches per location set (10) -> 6 patches/issue (40)
N_REPRO=4      # reproduction test samples (40)
